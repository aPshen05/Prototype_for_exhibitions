Процедура УстановкаПараметровСеанса(ИменаПараметровСеанса)

    Если ИменаПараметровСеанса = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Для Каждого ИмяПараметра Из ИменаПараметровСеанса Цикл

        Если ИмяПараметра = "ТекущийПользователь" Тогда

            ПараметрыСеанса.ТекущийПользователь =
                ПолучитьСсылкуТекущегоПользователя();

        КонецЕсли;

    КонецЦикла;
	
	
	Если ИменаПараметровСеанса = Неопределено Тогда

	    ПараметрыСеанса.ТекущийПользователь =
	        ПолучитьСсылкуТекущегоПользователя();

	ИначеЕсли ИменаПараметровСеанса.Найти(
	    "ТекущийПользователь") <> Неопределено Тогда

	    ПараметрыСеанса.ТекущийПользователь =
	        ПолучитьСсылкуТекущегоПользователя();

	КонецЕсли;

КонецПроцедуры



Функция ПолучитьСсылкуТекущегоПользователя()

    ПустаяСсылка =
        Справочники.Пользователи.ПустаяСсылка();

    ПользовательИБ =
        ПользователиИнформационнойБазы.ТекущийПользователь();

    Если ПользовательИБ = Неопределено Тогда
        Возврат ПустаяСсылка;
    КонецЕсли;

    Если ПустаяСтрока(ПользовательИБ.Имя) Тогда
        Возврат ПустаяСсылка;
    КонецЕсли;

    // Сначала ищем по UUID основной учётной записи.
    Ссылка = Справочники.Пользователи.НайтиПоРеквизиту(
        "ИдентификаторПользователяИБ",
        ПользовательИБ.УникальныйИдентификатор);

    // Если UUID не совпадает, пробуем имя входа.
    // Это важно для автономной информационной базы.
    Если Ссылка.Пустая() Тогда

        Запрос = Новый Запрос;

        Запрос.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 2
            |    Пользователи.Ссылка КАК Ссылка
            |ИЗ
            |    Справочник.Пользователи КАК Пользователи
            |ГДЕ
            |    Пользователи.ИмяПользователяИБ = &Имя
            |    И Пользователи.Недействителен = ЛОЖЬ";

        Запрос.УстановитьПараметр(
            "Имя", ПользовательИБ.Имя);

        Выборка = Запрос.Выполнить().Выбрать();

        Если Выборка.Следующий() Тогда

            Ссылка = Выборка.Ссылка;

            // Одинаковые имена в справочнике
            // не должны приводить к ошибочной привязке.
            Если Выборка.Следующий() Тогда
                ВызватьИсключение
                    "Неоднозначная привязка пользователя: "
                    + ПользовательИБ.Имя;
            КонецЕсли;

        КонецЕсли;

    КонецЕсли;

    Если Ссылка.Пустая() Тогда
        Возврат ПустаяСсылка;
    КонецЕсли;

    Если Ссылка.Недействителен Тогда
        Возврат ПустаяСсылка;
    КонецЕсли;

    Возврат Ссылка;

КонецФункции
