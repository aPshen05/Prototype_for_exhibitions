
&НаКлиенте
Перем ДанныеЗаписи;

&НаКлиенте
Перем ВремяНачалаЗаписи;

&НаКлиенте
Перем ДлительностьЗаписи;


// ОСТАНОВКА ЗАПИСИ

&НаКлиенте
Процедура КнопкаОстановитьНажатие(Команда)

    Если ЗначениеЗаполнено(ВремяНачалаЗаписи) Тогда
        ДлительностьЗаписи =
            Цел(ТекущаяДата() - ВремяНачалаЗаписи);
    КонецЕсли;

    ОтключитьОбработчикОжидания("ОбновитьТаймерЗаписи");

    #Если МобильныйКлиент Или МобильноеПриложениеКлиент Тогда

        Попытка
            СредстваМультимедиа.ОтключитьАудиозапись();
        Исключение
            Сообщить(
                "Не удалось остановить запись: "
                + ОписаниеОшибки());
        КонецПопытки;

    #Иначе

        Сообщить("Запись доступна только в мобильном приложении.");

    #КонецЕсли

КонецПроцедуры


// ПОЛУЧЕНИЕ ЗАВЕРШЁННОЙ АУДИОЗАПИСИ

&НаКлиенте
Процедура ПослеОстановкиАудиозаписи(
    РезультатАудиозаписи,
    ДополнительныеПараметры) Экспорт

    Если РезультатАудиозаписи = Неопределено Тогда
        ДанныеЗаписи = Неопределено;
        Элементы.ИдетЗапись.Заголовок = "Запись не получена";
        Возврат;
    КонецЕсли;

    ДанныеЗаписи = РезультатАудиозаписи;
    Элементы.ИдетЗапись.Заголовок = "Запись завершена";

КонецПроцедуры


// ОБНОВЛЕНИЕ ТАЙМЕРА

&НаКлиенте
Процедура ОбновитьТаймерЗаписи()

    Если Не ЗначениеЗаполнено(ВремяНачалаЗаписи) Тогда
        Возврат;
    КонецЕсли;

    Секунды = Цел(ТекущаяДата() - ВремяНачалаЗаписи);

    Минуты = Цел(Секунды / 60);
    ОстатокСекунд = Секунды - Минуты * 60;

    Элементы.ТаймерЗаписи.Заголовок =
        Строка(Минуты) + ":"
        + Формат(ОстатокСекунд, "ЧЦ=2; ЧВН=");

КонецПроцедуры


// СОХРАНЕНИЕ АУДИО

&НаКлиенте
Процедура КнопкаСохранитьНажатие(Команда)

    Если ДанныеЗаписи = Неопределено Тогда
        Сообщить("Сначала запиши аудио и нажми «Остановить».");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Контакт) Тогда
        Сообщить("Не удалось определить контакт для сохранения.");
        Возврат;
    КонецЕсли;

    Попытка

        ДвоичныеДанные =
            ДанныеЗаписи.ПолучитьДвоичныеДанные();

        Если ДвоичныеДанные = Неопределено Тогда
            Сообщить("Не удалось получить аудиоданные.");
            Возврат;
        КонецЕсли;

        СохранитьАудиоНаСервере(
		    ДвоичныеДанные,
		    Контакт,
		    ДлительностьЗаписи);

		Если ВладелецФормы <> Неопределено Тогда
		    ВладелецФормы.ОбновитьТаблицуВложений();
		КонецЕсли;

		Закрыть();		    
		
    Исключение

        Сообщить(
            "Ошибка сохранения: "
            + ОписаниеОшибки());

    КонецПопытки;

КонецПроцедуры


// ИНИЦИАЛИЗАЦИЯ ФОРМЫ

&НаКлиенте
Процедура ПриОткрытии(Отказ)

    ДанныеЗаписи = Неопределено;
    ВремяНачалаЗаписи = Неопределено;
    ДлительностьЗаписи = 0;

    Элементы.ТаймерЗаписи.Заголовок = "0:00";
    Элементы.ИдетЗапись.Заголовок = "Готово к записи";

КонецПроцедуры


// НАЧАЛО ЗАПИСИ

&НаКлиенте
Процедура КнопкаНачатьЗаписьНажатие(Команда)

    #Если МобильныйКлиент Или МобильноеПриложениеКлиент Тогда

        ОписаниеОстановки = Новый ОписаниеОповещения(
            "ПослеОстановкиАудиозаписи",
            ЭтаФорма);

        Попытка

            ДанныеЗаписи = Неопределено;
            ДлительностьЗаписи = 0;
            ВремяНачалаЗаписи = ТекущаяДата();

            СредстваМультимедиа.ВключитьАудиозапись(
                ОписаниеОстановки,
                Новый ПараметрыАудиозаписи,
                Неопределено);

            Элементы.ИдетЗапись.Заголовок = "Идёт запись";

            ПодключитьОбработчикОжидания(
                "ОбновитьТаймерЗаписи",
                1,
                Ложь);

        Исключение

            ВремяНачалаЗаписи = Неопределено;
            ОтключитьОбработчикОжидания("ОбновитьТаймерЗаписи");

            Элементы.ИдетЗапись.Заголовок =
                "Не удалось начать запись";

            Сообщить(ОписаниеОшибки());

        КонецПопытки;

    #Иначе

        Сообщить("Запись доступна только в мобильном приложении.");

    #КонецЕсли

КонецПроцедуры


// ПОЛУЧЕНИЕ КОНТАКТА

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Параметры.Свойство("Контакт") Тогда
        Контакт = Параметры.Контакт;
    КонецЕсли;

КонецПроцедуры

// СОХРАНЕНИЕ В СПРАВОЧНИК ВЛОЖЕНИЙ

&НаСервере
Процедура СохранитьАудиоНаСервере(
    ДвоичныеДанные,
    СсылкаНаКонтакт,
    Длительность)

    Вложение = Справочники.Вложения.СоздатьЭлемент();

    Вложение.Владелец = СсылкаНаКонтакт;
    Вложение.Контакт = СсылкаНаКонтакт;
    Вложение.Вид = Перечисления.ВидыВложений.Аудио;

    Вложение.Данные =
        Новый ХранилищеЗначения(ДвоичныеДанные);

    Вложение.Имя = "Аудиозаметка";
    Вложение.Размер = ДвоичныеДанные.Размер();
    Вложение.ДлительностьСекунд = Длительность;

    Вложение.Записать();

КонецПроцедуры
