&НаКлиенте
Процедура ПослеЗаписиГолоса(
    РаспознанныйТекст,
    ДополнительныеПараметры) Экспорт

    Если РаспознанныйТекст <> Неопределено
        И ЗначениеЗаполнено(СокрЛП(РаспознанныйТекст)) Тогда

        Если ЗначениеЗаполнено(Объект.Комментарий) Тогда

            Объект.Комментарий =
                Объект.Комментарий
                + Символы.ПС
                + " "
                + СокрЛП(РаспознанныйТекст);

        Иначе

            Объект.Комментарий =
                " "
                + СокрЛП(РаспознанныйТекст);

        КонецЕсли;

        Элементы.КнопкаНаговорить.Заголовок = "записано ✓";
        ПоказатьОповещениеПользователя("Голосовая заметка добавлена");

    КонецЕсли;

КонецПроцедуры


