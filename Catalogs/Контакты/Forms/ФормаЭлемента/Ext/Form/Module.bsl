        ОткрытьФорму(
            "Справочник.Контакты.Форма.ФормаПросмотраФото",
            ПараметрыФормы,
            ЭтаФорма);

    ИначеЕсли ВидВложения = ПредопределенноеЗначение(
        "Перечисление.ВидыВложений.Аудио") Тогда

        Сообщить(
            "Выбрана аудиозапись. Воспроизведение подключим следующим этапом.");

    КонецЕсли;

