&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Объект.Ссылка.Пустая() Тогда
        РежимВвода = 1;
        ЭтаФорма.Заголовок = "Новый контакт";

        Если Параметры.Свойство("ЗначенияЗаполнения")
            И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") Тогда

            Если Параметры.ЗначенияЗаполнения.Свойство("Выставка") Тогда
                Объект.Выставка = Параметры.ЗначенияЗаполнения.Выставка;
            КонецЕсли;

        КонецЕсли;

    Иначе

        ЭтаФорма.Заголовок = "Контакт №" + Объект.Код;

        Если ЗначениеЗаполнено(Объект.Партнер) Тогда
            РежимВвода = 0;
        Иначе
            РежимВвода = 1;
        КонецЕсли;

    КонецЕсли;

    ЗаполнитьСписокТемНаСервере();
    ОбновитьВидимостьРежимаВвода();

    СписокВложений.Параметры.УстановитьЗначениеПараметра(
        "Контакт",
        Объект.Ссылка);

КонецПроцедуры


