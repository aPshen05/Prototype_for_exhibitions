&НаСервере
Процедура ЗаполнитьСписокТемНаСервере()

    СписокТем.Очистить();

    Выборка = Справочники.ТемыИнтереса.Выбрать();

    Пока Выборка.Следующий() Цикл

        Если Выборка.ПометкаУдаления Тогда
            Продолжить;
        КонецЕсли;

        ТемаОтмечена = Ложь;

        Для Каждого СтрокаТемы Из Объект.Темы Цикл

            Если СтрокаТемы.Тема = Выборка.Ссылка Тогда
                ТемаОтмечена = Истина;
                Прервать;
            КонецЕсли;

        КонецЦикла;

        НовыйЭлемент = СписокТем.Добавить(
            Выборка.Ссылка,
            Выборка.Наименование,
            ТемаОтмечена);

    КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(
    Отказ,
    ТекущийОбъект,
    ПараметрыЗаписи)

    Если Не ЗначениеЗаполнено(ТекущийОбъект.Выставка)
        И Параметры.Свойство("ЗначенияЗаполнения") Тогда

        Если ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура")
            И Параметры.ЗначенияЗаполнения.Свойство("Выставка") Тогда

            ТекущийОбъект.Выставка =
                Параметры.ЗначенияЗаполнения.Выставка;

        КонецЕсли;

    КонецЕсли;

    Если Не ЗначениеЗаполнено(ТекущийОбъект.ДатаФиксации) Тогда
        ТекущийОбъект.ДатаФиксации = ТекущаяДатаСеанса();
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ТекущийОбъект.ИдентификаторМобильный) Тогда
        ТекущийОбъект.ИдентификаторМобильный =
            Новый УникальныйИдентификатор;
    КонецЕсли;

    Если ЗначениеЗаполнено(ТекущийОбъект.Партнер) Тогда

        ТекущийОбъект.Наименование =
            СокрЛП(Строка(ТекущийОбъект.Партнер));

    ИначеЕсли ЗначениеЗаполнено(ТекущийОбъект.НаименованиеОрганизации) Тогда

        ТекущийОбъект.Наименование =
            СокрЛП(ТекущийОбъект.НаименованиеОрганизации);

    ИначеЕсли ЗначениеЗаполнено(ТекущийОбъект.ФИОКонтакта) Тогда

        ТекущийОбъект.Наименование =
            СокрЛП(ТекущийОбъект.ФИОКонтакта);

    Иначе

        ТекущийОбъект.Наименование = "без визитки";

    КонецЕсли;

    ТекущийОбъект.Темы.Очистить();

    Для Каждого ЭлементСписка Из СписокТем Цикл

        Если ЭлементСписка.Пометка Тогда

            НоваяТема = ТекущийОбъект.Темы.Добавить();
            НоваяТема.Тема = ЭлементСписка.Значение;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры


