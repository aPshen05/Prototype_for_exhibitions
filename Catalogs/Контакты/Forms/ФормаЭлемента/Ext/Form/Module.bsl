&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		РежимВвода = 1;
		ЭтаФорма.Заголовок = "Новый контакт";
		
		// ЖЕЛЕЗОБЕТОННО ловим выставку из параметров и ставим в сам объект
		Если Параметры.Свойство("ЗначенияЗаполнения") И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") Тогда
			Если Параметры.ЗначенияЗаполнения.Свойство("Выставка") Тогда
				Объект.Выставка = Параметры.ЗначенияЗаполнения.Выставка;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ЭтаФорма.Заголовок = "Контакт №" + Объект.Код;
		Если ЗначениеЗаполнено(Объект.Партнер) Тогда
			РежимВвода = 0;
		Иначе
			РежимВвода = 1;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьСписокТемНаСервере();  
	
	ЗаполнитьСписокТемНаСервере();
	ОбновитьВидимостьРежимаВвода();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьСтраницРежима();
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаПриИзменении(Элемент)
	
	Если РежимВвода = 0 Тогда
		// Если переключили на "Из базы" — очищаем ручной ввод организации
		Объект.НаименованиеОрганизации = "";
	Иначе
		// Если переключили на "Новый" — сбрасываем выбранного партнера из базы
		Объект.Партнер = Неопределено;
	КонецЕсли;
	
	ОбновитьВидимостьРежимаВвода();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьСтраницРежима()
	Если РежимВвода = 0 Тогда
		Элементы.СтраницыРежима.ТекущаяСтраница = Элементы.СтраницаИзБазы;
	Иначе
		Элементы.СтраницыРежима.ТекущаяСтраница = Элементы.СтраницаНовый;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТемНаСервере()
	
	СписокТем.Очистить();
	
	Выборка = Справочники.ТемыИнтереса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		// Проверяем обычным циклом, есть ли уже эта тема у контакта
		ТемаОтмечена = Ложь;
		Для Каждого СтрокаТемы Из Объект.Темы Цикл
			Если СтрокаТемы.Тема = Выборка.Ссылка Тогда
				ТемаОтмечена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// Добавляем тему в список на форме и ставим галочку, если нужно
		НовыйЭлемент = СписокТем.Добавить(Выборка.Ссылка, Выборка.Наименование, ТемаОтмечена);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Железно привязываем контакт к выставке, чтобы он появился в списке
	Если Не ЗначениеЗаполнено(ТекущийОбъект.Выставка) И Параметры.Свойство("ЗначенияЗаполнения") Тогда
		Если ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") И Параметры.ЗначенияЗаполнения.Свойство("Выставка") Тогда
			ТекущийОбъект.Выставка = Параметры.ЗначенияЗаполнения.Выставка;
		КонецЕсли;
	КонецЕсли;
	
	// Ставим время фиксации и уникальный ID
	Если Не ЗначениеЗаполнено(ТекущийОбъект.ДатаФиксации) Тогда
		ТекущийОбъект.ДатаФиксации = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущийОбъект.ИдентификаторМобильный) Тогда
		ТекущийОбъект.ИдентификаторМобильный = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	// Формируем название для списка
	Если ЗначениеЗаполнено(ТекущийОбъект.Партнер) Тогда
		ТекущийОбъект.Наименование = СокрЛП(Строка(ТекущийОбъект.Партнер));
	ИначеЕсли ЗначениеЗаполнено(ТекущийОбъект.НаименованиеОрганизации) Тогда
		ТекущийОбъект.Наименование = СокрЛП(ТекущийОбъект.НаименованиеОрганизации);
	ИначеЕсли ЗначениеЗаполнено(ТекущийОбъект.ФИОКонтакта) Тогда
		ТекущийОбъект.Наименование = СокрЛП(ТекущийОбъект.ФИОКонтакта);
	Иначе
		ТекущийОбъект.Наименование = "без визитки";
	КонецЕсли;
	
	// Сохраняем отмеченные галочками темы интереса
	ТекущийОбъект.Темы.Очистить();
	Для Каждого ЭлементСписка Из СписокТем Цикл
		Если ЭлементСписка.Пометка Тогда
			НоваяТема = ТекущийОбъект.Темы.Добавить();
			НоваяТема.Тема = ЭлементСписка.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКонтакт(Команда)
	// Сохраняем объект в базу
	Если Записать() Тогда
		// Оповещаем главный экран о новом контакте
		Оповестить("КонтактСохранен", Объект.Код);
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьРежимаВвода()
	
	Если РежимВвода = 0 Тогда
		Элементы.СтраницыРежима.ТекущаяСтраница = Элементы.СтраницаИзБазы;
	Иначе
		Элементы.СтраницыРежима.ТекущаяСтраница = Элементы.СтраницаНовый;
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработчикиКомандМедиа

// --- 1. ЗАПИСЬ ГОЛОСА (ОКНО ЗАПИСИ) ---
&НаКлиенте
Процедура Наговорить(Команда)
	
	// Вызываем окно записи голосовой заметки
	Оповещение = Новый ОписаниеОповещения("ПослеЗаписиГолоса", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, "", " Запись голосовой заметки (говорите)...", 0, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиГолоса(РаспознанныйТекст, ДополнительныеПараметры) Экспорт
	
	Если РаспознанныйТекст <> Неопределено И ЗначениеЗаполнено(СокрЛП(РаспознанныйТекст)) Тогда
		
		// Аккуратно добавляем распознанную речь в поле "что обсудили"
		Если ЗначениеЗаполнено(Объект.Комментарий) Тогда
			Объект.Комментарий = Объект.Комментарий + Символы.ПС + " " + СокрЛП(РаспознанныйТекст);
		Иначе
			Объект.Комментарий = " " + СокрЛП(РаспознанныйТекст);
		КонецЕсли;
		
		// Меняем заголовок кнопки, чтобы было видно, что запись прикреплена
		Элементы.КнопкаНаговорить.Заголовок = " записано ✓";
		ПоказатьОповещениеПользователя("Голосовая заметка добавлена");
		
	КонецЕсли;
	
КонецПроцедуры


// --- 2. ПРИКРЕПЛЕНИЕ ФОТО (КАМЕРА ИЛИ ФАЙЛ) ---
&НаКлиенте
Процедура СделатьФото(Команда)
	
	#Если МобильноеПриложениеКлиент Тогда
		// Если запущено на телефоне — включаем настоящую камеру
		Если СредстваМультимедиа.ПоддерживаетсяФотоснимки() Тогда
			ДанныеФото = СредстваМультимедиа.СделатьФотоснимок();
			Если ДанныеФото <> Неопределено Тогда
				СохранитьФотоНаСервере(ДанныеФото.ПолучитьДвоичныеДанные());
				Элементы.КнопкаФото.Заголовок = " фото (1) ✓";
				ПоказатьОповещениеПользователя("Фото визитки прикреплено");
			КонецЕсли;
			Возврат;
		КонецЕсли;
	#Иначе
		// Если проверяем на компьютере (Тонкий клиент) — современный диалог выбора файла
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораФото", ЭтотОбъект);
		ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
		ПараметрыДиалога.Заголовок = "Выберите фото визитки или стенда";
		ПараметрыДиалога.Фильтр = "Изображения (*.jpg;*.png;*.jpeg)|*.jpg;*.png;*.jpeg|Все файлы (*.*)|*.*";
		
		НачатьПомещениеФайлаНаСервер(Оповещение, , , ПараметрыДиалога, УникальныйИдентификатор);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФото(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеПомещенногоФайла <> Неопределено Тогда
		СохранитьФотоИзХранилищаНаСервере(ОписаниеПомещенногоФайла.Адрес);
		Элементы.КнопкаФото.Заголовок = " фото ✓";
		ПоказатьОповещениеПользователя("Фото прикреплено: " + ОписаниеПомещенногоФайла.СсылкаНаФайл.Имя);
	КонецЕсли;
	
КонецПроцедуры

