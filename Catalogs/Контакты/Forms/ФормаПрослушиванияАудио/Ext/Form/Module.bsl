&НаКлиенте
Перем СекундыВоспроизведения;

&НаКлиенте
Процедура КнопкаВоспроизвестиНажатие(Команда)

    Если Не ЗначениеЗаполнено(СсылкаНаВложение) Тогда
        Сообщить("Аудиовложение не выбрано.");
        Возврат;
    КонецЕсли;

    ДанныеАудио = ПолучитьДанныеАудиоНаСервере(
        СсылкаНаВложение);

    Если ДанныеАудио = Неопределено Тогда
        Сообщить("Не удалось получить аудиозапись.");
        Возврат;
    КонецЕсли;

    ИмяАудио = ДанныеАудио.Имя;
    ДлительностьСекунд = ДанныеАудио.ДлительностьСекунд; 
	
	ОбновитьОтображениеВремени();

    #Если МобильныйКлиент Или МобильноеПриложениеКлиент Тогда

        Попытка

		    СредстваМультимедиа.ВоспроизвестиАудио(
		        ДанныеАудио.Данные);

		    СекундыВоспроизведения = 0;

		    Элементы.НадписьВремени.Заголовок =
		        "0:00/" + ФорматироватьВремя(ДлительностьСекунд);

		    ПодключитьОбработчикОжидания(
		        "ОбновитьТаймерВоспроизведения",
		        1,
		        Ложь);

		Исключение

		    ОтключитьОбработчикОжидания(
		        "ОбновитьТаймерВоспроизведения");

		    Сообщить(
		        "Не удалось воспроизвести аудиозапись: "
		        + ОписаниеОшибки());

		КонецПопытки;       
			
			
    #Иначе

        Сообщить(
            "Воспроизведение доступно только в мобильном приложении.");

    #КонецЕсли

КонецПроцедуры


&НаКлиенте
Процедура КнопкаОстановитьНажатие(Команда)               
	
	ОтключитьОбработчикОжидания(
    "ОбновитьТаймерВоспроизведения");

    #Если МобильныйКлиент Или МобильноеПриложениеКлиент Тогда

        СредстваМультимедиа.ОстановитьВоспроизведениеАудио();

    #Иначе

        Сообщить(
            "Остановка воспроизведения доступна только в мобильном приложении.");

    #КонецЕсли

КонецПроцедуры


&НаСервере
Функция ПолучитьДанныеАудиоНаСервере(СсылкаНаВложение)

    Если Не ЗначениеЗаполнено(СсылкаНаВложение) Тогда
        Возврат Неопределено;
    КонецЕсли;

    ОбъектВложения = СсылкаНаВложение.ПолучитьОбъект();

    ДвоичныеДанные = ОбъектВложения.Данные.Получить();

    Если ДвоичныеДанные = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("Данные", ДвоичныеДанные);
    Результат.Вставить("Имя", ОбъектВложения.Имя);
    Результат.Вставить(
        "ДлительностьСекунд",
        ОбъектВложения.ДлительностьСекунд);

    Возврат Результат;

КонецФункции           


&НаКлиенте
Функция ФорматироватьВремя(Секунды)

    Если Секунды < 0 Тогда
        Секунды = 0;
    КонецЕсли;

    Минуты = Цел(Секунды / 60);
    ОстатокСекунд = Секунды - Минуты * 60;

    Возврат Строка(Минуты) + ":"
        + Формат(ОстатокСекунд, "ЧЦ=2; ЧВН=");

КонецФункции


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Не Параметры.Свойство(
        "СсылкаНаВложение",
        СсылкаНаВложение) Тогда

        Возврат;

    КонецЕсли;

    Если Не ЗначениеЗаполнено(СсылкаНаВложение) Тогда
        Возврат;
    КонецЕсли;

    ОбъектВложения = СсылкаНаВложение.ПолучитьОбъект();

    ИмяАудио = ОбъектВложения.Имя;
    ДлительностьСекунд = ОбъектВложения.ДлительностьСекунд;

КонецПроцедуры  


&НаКлиенте
Процедура ОбновитьОтображениеВремени()

    Элементы.НадписьВремени.Заголовок =
        ФорматироватьВремя(ДлительностьСекунд);

КонецПроцедуры                                         
	
&НаКлиенте
Процедура ОбновитьТаймерВоспроизведения()

    СекундыВоспроизведения =
        СекундыВоспроизведения + 1;

    Если СекундыВоспроизведения > ДлительностьСекунд Тогда
        СекундыВоспроизведения = ДлительностьСекунд;
        ОтключитьОбработчикОжидания(
            "ОбновитьТаймерВоспроизведения");
        Возврат;
    КонецЕсли;

    Элементы.НадписьВремени.Заголовок =
        ФорматироватьВремя(СекундыВоспроизведения)
        + "/"
        + ФорматироватьВремя(ДлительностьСекунд);

КонецПроцедуры