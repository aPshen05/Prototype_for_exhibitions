 #Область ОбработчикиСобытий

Процедура ПриУстановкеНовогоКода(СтандартнаяОбработка, Префикс)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторМобильный) Тогда
		ИдентификаторМобильный = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаФиксации) Тогда
		ДатаФиксации = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторМобильный) Тогда
		ИдентификаторМобильный = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаФиксации) Тогда
		ДатаФиксации = ТекущаяДатаСеанса();
	КонецЕсли;
	
	// Автоформирование наименования для списка на главном экране (макет 05.2)
	Если ЗначениеЗаполнено(Партнер) Тогда
		Наименование = СокрЛП(Строка(Партнер));
	ИначеЕсли ЗначениеЗаполнено(НаименованиеОрганизации) Тогда
		Наименование = СокрЛП(НаименованиеОрганизации);
	ИначеЕсли ЗначениеЗаполнено(ФИОКонтакта) Тогда
		Наименование = СокрЛП(ФИОКонтакта);
	Иначе
		Наименование = "без визитки";
	КонецЕсли;   
	
	// Проверяем, что элемент новый и реквизит Ответственный пустой
    Если ЭтоНовый() И НЕ ЗначениеЗаполнено(Ответственный) Тогда
        
        // Находим текущего пользователя ИБ и привязываем его
        ТекущийПИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
        Если ТекущийПИБ <> Неопределено Тогда
            УИД = ТекущийПИБ.УникальныйИдентификатор;
            
            Запрос = Новый Запрос;
            Запрос.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   Пользователи.Ссылка КАК Ссылка
                |ИЗ
                |   Справочник.Пользователи КАК Пользователи
                |ГДЕ
                |   Пользователи.ИдентификаторПользователяИБ = &УИД";
                
            Запрос.УстановитьПараметр("УИД", УИД);
            РезультатЗапроса = Запрос.Выполнить();
            
            Если Не РезультатЗапроса.Пустой() Тогда
                Выборка = РезультатЗапроса.Выбрать();
                Выборка.Следующий();
                Ответственный = Выборка.Ссылка;
            КонецЕсли;
        КонецЕсли;
        
    КонецЕсли;	
КонецПроцедуры


#КонецОбласти