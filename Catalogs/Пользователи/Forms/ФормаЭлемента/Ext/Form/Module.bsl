
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ОбновитьВидимостьКнопкиСоздатьПользователяИБ();

КонецПроцедуры


&НаСервере
Процедура ОбновитьВидимостьКнопкиСоздатьПользователяИБ()

    НулевойUUID = Новый УникальныйИдентификатор(
        "00000000-0000-0000-0000-000000000000"
    );

    ИдентификаторИБ = Объект.ИдентификаторПользователяИБ;

    Если ИдентификаторИБ = НулевойUUID Тогда

        Элементы.КнопкаСоздатьПользователяИБ.Видимость = Истина;

        Возврат;

    КонецЕсли;

    Попытка

        ЕстьПользовательИБ =
            ПользователиИБСлужебный.СуществуетПользовательИБПоUUID(
                ИдентификаторИБ
            );

        Элементы.КнопкаСоздатьПользователяИБ.Видимость =
            Не ЕстьПользовательИБ;

    Исключение

        Элементы.КнопкаСоздатьПользователяИБ.Видимость = Истина;

    КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура КнопкаПривязатьПользователяИБНажатие(Команда)

    ИдентификаторИБ = ПолучитьUUIDТекущегоПользователяИБ();

    Если ИдентификаторИБ = Неопределено Тогда

        Сообщить("Не удалось получить UUID пользователя ИБ.");

        Возврат;

    КонецЕсли;

    Объект.ИдентификаторПользователяИБ = ИдентификаторИБ;

    Если Записать() Тогда

        Сообщить("Пользователь ИБ успешно привязан.");

        ОбновитьВидимостьКнопкиСоздатьПользователяИБ();

    КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ПолучитьUUIDТекущегоПользователяИБ()

    ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();

    Если ПользовательИБ = Неопределено
        Или ПустаяСтрока(ПользовательИБ.Имя) Тогда

        Возврат Неопределено;

    КонецЕсли;

    Если НРег(СокрЛП(Объект.Наименование))
        <> НРег(СокрЛП(ПользовательИБ.Имя)) Тогда

        Возврат Неопределено;

    КонецЕсли;

    Возврат ПользовательИБ.УникальныйИдентификатор;

КонецФункции


&НаКлиенте
Процедура КнопкаСоздатьПользователяИБНажатие(Команда)

    Результат = СоздатьИлиПривязатьПользователяИБНаСервере();

    Если Не Результат.Успешно Тогда

        Сообщить(Результат.Сообщение);

        Возврат;

    КонецЕсли;

    Объект.ИдентификаторПользователяИБ = Результат.UUID;

    Если Записать() Тогда

        Сообщить(Результат.Сообщение);

        ОбновитьВидимостьКнопкиСоздатьПользователяИБ();

    Иначе

        Сообщить("Не удалось сохранить идентификатор пользователя.");

    КонецЕсли;

КонецПроцедуры


&НаСервере
Функция СоздатьИлиПривязатьПользователяИБНаСервере()

    Результат = Новый Структура;

    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("UUID", Неопределено);
    Результат.Вставить("Сообщение", "");

    Если Не РольДоступна(Метаданные.Роли.ПолныеПрава) Тогда

        Результат.Сообщение =
            "Создавать пользователей ИБ может только пользователь с ролью ПолныеПрава.";

        Возврат Результат;

    КонецЕсли;

    Если Объект.Ссылка.Пустая() Тогда

        Результат.Сообщение =
            "Сначала сохраните элемент справочника Пользователи.";

        Возврат Результат;

    КонецЕсли;

    Если Объект.Недействителен Тогда

        Результат.Сообщение =
            "Нельзя создавать пользователя ИБ для недействительного пользователя.";

        Возврат Результат;

    КонецЕсли;

    ИмяПользователя = СокрЛП(Объект.Наименование);

    Если ПустаяСтрока(ИмяПользователя) Тогда

        Результат.Сообщение =
            "Не заполнено наименование пользователя.";

        Возврат Результат;

    КонецЕсли;

    Попытка

        РезультатИБ =
            ПользователиИБСлужебный.ПолучитьИлиСоздатьПользователяИБ(
                ИмяПользователя,
                Объект.Наименование
            );

        Если Не РезультатИБ.Успешно Тогда

            Результат.Сообщение = РезультатИБ.Сообщение;

            Возврат Результат;

        КонецЕсли;

        ДругойПользователь = Справочники.Пользователи.НайтиПоРеквизиту(
            "ИдентификаторПользователяИБ",
            РезультатИБ.UUID
        );

        Если Не ДругойПользователь.Пустая()
            И ДругойПользователь <> Объект.Ссылка Тогда

            Результат.Сообщение =
                "Этот пользователь ИБ уже связан с другим элементом справочника.";

            Возврат Результат;

        КонецЕсли;

        Результат.UUID = РезультатИБ.UUID;
        Результат.Успешно = Истина;
        Результат.Сообщение = РезультатИБ.Сообщение;

    Исключение

        Результат.Сообщение =
            "Ошибка создания или привязки пользователя ИБ: "
            + ОписаниеОшибки();

    КонецПопытки;

    Возврат Результат;

КонецФункции