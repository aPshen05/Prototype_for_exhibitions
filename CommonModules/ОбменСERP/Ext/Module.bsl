
&НаКлиенте
Функция ПолучитьДанныеИзERP(Путь)

    Соединение = Новый HTTPСоединение(
        "10.43.42.29",
        80,
        ,
        ,
        ,
        30);

    Запрос = Новый HTTPЗапрос(Путь);
    Ответ = Соединение.Получить(Запрос);

    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение
            "Ошибка HTTP: " + Строка(Ответ.КодСостояния);
    КонецЕсли;

    ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстОтвета);

    Данные = ПрочитатьJSON(ЧтениеJSON);

    ЧтениеJSON.Закрыть();

    Возврат Данные;

КонецФункции


&НаКлиенте
Процедура СинхронизироватьСERP() Экспорт

    Попытка

        ПартнерыERP = ПолучитьДанныеИзERP(
            "/ERP/hs/mobileexchange/partners");

        КонтактыERP = ПолучитьДанныеИзERP(
            "/ERP/hs/mobileexchange/contactpersons");

        Результат = ОбменСERPВызовСервера.ЗаписатьДанныеНаСервере(
		    ПартнерыERP,
		    КонтактыERP);

        Сообщить(Результат);

    Исключение

        Сообщить(
            "Ошибка синхронизации: "
            + ОписаниеОшибки());

    КонецПопытки;

КонецПроцедуры


