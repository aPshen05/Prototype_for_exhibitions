
#Если Сервер И Не МобильноеПриложениеСервер И Не МобильныйАвтономныйСервер Тогда

Функция ЗагрузитьТестМенеджераИзERP() Экспорт

    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Загрузка доступна только администратору.";
    КонецЕсли;

    Коннектор = Новый COMОбъект("V85.COMConnector");

    СоединениеERP = Коннектор.Connect(
        "File=""E:\1с\Базы\ERP"";Usr=""Администратор"";");

    // Получаем массив пользователей ERP.
    ПользователиCOM =
        СоединениеERP.ВыгрузкаПользователейERP.
            ПолучитьПользователейДляProt();

    Пакет = Новый Массив;

    КоличествоПользователей = ПользователиCOM.Количество();

    Для Индекс = 0 По КоличествоПользователей - 1 Цикл

        ДанныеCOM = ПользователиCOM.Получить(Индекс);

        Данные = Новый Структура;

        Данные.Вставить(
            "Имя", Строка(ДанныеCOM.Имя));

        Данные.Вставить(
            "ПолноеИмя", Строка(ДанныеCOM.ПолноеИмя));

        Данные.Вставить(
            "ИдентификаторERP",
            Строка(ДанныеCOM.ИдентификаторERP));

        Данные.Вставить(
            "СохраняемоеЗначениеПароля",
            Строка(ДанныеCOM.СохраняемоеЗначениеПароля));

        Пакет.Добавить(Данные);

    КонецЦикла;

    // Отсоединяемся от ERP.
    ДанныеCOM = Неопределено;
    ПользователиCOM = Неопределено;
    СоединениеERP = Неопределено;
    Коннектор = Неопределено;

    Результат =
        ЗагрузкаПользователейERP.
            СинхронизироватьПользователей(Пакет);

    Возврат "Синхронизация завершена. Создано: "
        + Строка(Результат.Создано)
        + "; Обновлено: "
        + Строка(Результат.Обновлено);

КонецФункции

#КонецЕсли
