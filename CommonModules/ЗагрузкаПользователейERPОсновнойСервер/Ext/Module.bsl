
#Если Сервер И Не МобильноеПриложениеСервер И Не МобильныйАвтономныйСервер Тогда

Функция ЗагрузитьТестМенеджераИзERP() Экспорт

    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Загрузка доступна только администратору.";
    КонецЕсли;

    Коннектор = Новый COMОбъект("V85.COMConnector");

    СоединениеERP = Коннектор.Connect(
        "File=""E:\1с\Базы\ERP"";Usr=""Администратор"";");

    // Получаем массив пользователей ERP.
    ПользователиCOM =
        СоединениеERP.ВыгрузкаПользователейERP.
            ПолучитьПользователейДляProt();

    Пакет = Новый Массив;

    КоличествоПользователей = ПользователиCOM.Количество();

    Для Индекс = 0 По КоличествоПользователей - 1 Цикл

        ДанныеCOM = ПользователиCOM.Получить(Индекс);

        Данные = Новый Структура;

        Данные.Вставить(
            "Имя", Строка(ДанныеCOM.Имя));

        Данные.Вставить(
            "ПолноеИмя", Строка(ДанныеCOM.ПолноеИмя));

        Данные.Вставить(
            "ИдентификаторERP",
            Строка(ДанныеCOM.ИдентификаторERP));

        Данные.Вставить(
            "СохраняемоеЗначениеПароля",
            Строка(ДанныеCOM.СохраняемоеЗначениеПароля));

        Пакет.Добавить(Данные);

    КонецЦикла;

    // Отсоединяемся от ERP.
    ДанныеCOM = Неопределено;
    ПользователиCOM = Неопределено;
    СоединениеERP = Неопределено;
    Коннектор = Неопределено;

    Результат =
        ЗагрузкаПользователейERP.
            СинхронизироватьПользователей(Пакет);

    Возврат "Синхронизация завершена. Создано: "
        + Строка(Результат.Создано)
        + "; Обновлено: "
        + Строка(Результат.Обновлено);

КонецФункции


Функция ПолучитьСписокДляВыбора() Экспорт

    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Недостаточно прав для просмотра пользователей ERP.";
    КонецЕсли;

    Коннектор = Новый COMОбъект("V85.COMConnector");

    СоединениеERP = Коннектор.Connect(
        "File=""E:\1с\Базы\ERP"";Usr=""Администратор"";");

    ПользователиCOM =
        СоединениеERP.ВыгрузкаПользователейERP.
            ПолучитьСписокПользователей();

    Результат = Новый Массив;

    Для Индекс = 0 По ПользователиCOM.Количество() - 1 Цикл

        ДанныеCOM = ПользователиCOM.Получить(Индекс);

        Имя = Строка(ДанныеCOM.Имя);
        ИдентификаторERP =
            Строка(ДанныеCOM.ИдентификаторERP);

        Доступен = Истина;
        Состояние = "";

        Если Имя = "Администратор"
            Или ДанныеCOM.АдминистраторERP Тогда

            Доступен = Ложь;
            Состояние = "Администратор ERP";

        ИначеЕсли Не ДанныеCOM.АутентификацияСтандартная Тогда

            Доступен = Ложь;
            Состояние = "Нет аутентификации 1С";

        ИначеЕсли Не ДанныеCOM.ПарольУстановлен Тогда

            Доступен = Ложь;
            Состояние = "Не установлен пароль";

        Иначе

            Ссылка = Справочники.Пользователи.НайтиПоРеквизиту(
                "ИдентификаторERP",
                Новый УникальныйИдентификатор(ИдентификаторERP));

            Если Ссылка.Пустая() Тогда
                Состояние = "Новый";
            Иначе
                Состояние = "Уже загружен";
            КонецЕсли;

        КонецЕсли;

        Данные = Новый Структура;

        Данные.Вставить("Имя", Имя);
        Данные.Вставить(
            "ПолноеИмя",
            Строка(ДанныеCOM.ПолноеИмя));

        Данные.Вставить(
            "ИдентификаторERP",
            ИдентификаторERP);

        Данные.Вставить("Доступен", Доступен);
        Данные.Вставить("Состояние", Состояние);

        Результат.Добавить(Данные);

    КонецЦикла;

    ДанныеCOM = Неопределено;
    ПользователиCOM = Неопределено;
    СоединениеERP = Неопределено;
    Коннектор = Неопределено;

    Возврат Результат;

КонецФункции


Функция ЗагрузитьВыбранныхИзERP(
    ВыбранныеИдентификаторы) Экспорт

    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Загрузка доступна только администратору.";
    КонецЕсли;

    Если ВыбранныеИдентификаторы.Количество() = 0 Тогда
        ВызватьИсключение
            "Не выбраны пользователи для загрузки.";
    КонецЕсли;

    Коннектор = Новый COMОбъект("V85.COMConnector");

    СоединениеERP = Коннектор.Connect(
        "File=""E:\1с\Базы\ERP"";Usr=""Администратор"";");

    // Получаем только разрешённых для импорта пользователей ERP.
    ПользователиCOM =
        СоединениеERP.ВыгрузкаПользователейERP.
            ПолучитьПользователейДляProt();

    Пакет = Новый Массив;

    Для Индекс = 0 По ПользователиCOM.Количество() - 1 Цикл

        ДанныеCOM = ПользователиCOM.Получить(Индекс);

        ИдентификаторERP =
            Строка(ДанныеCOM.ИдентификаторERP);

        Если ВыбранныеИдентификаторы.Найти(
            ИдентификаторERP) = Неопределено Тогда

            Продолжить;

        КонецЕсли;

        Данные = Новый Структура;

        Данные.Вставить(
            "ИдентификаторERP",
            ИдентификаторERP);

        Данные.Вставить(
            "Имя",
            Строка(ДанныеCOM.Имя));

        Данные.Вставить(
            "ПолноеИмя",
            Строка(ДанныеCOM.ПолноеИмя));

        Данные.Вставить(
            "СохраняемоеЗначениеПароля",
            Строка(ДанныеCOM.СохраняемоеЗначениеПароля));

        Пакет.Добавить(Данные);

    КонецЦикла;

    ДанныеCOM = Неопределено;
    ПользователиCOM = Неопределено;
    СоединениеERP = Неопределено;
    Коннектор = Неопределено;

    // Проверяем, что удалось найти всех выбранных.
    Если Пакет.Количество() <>
        ВыбранныеИдентификаторы.Количество() Тогда

        ВызватьИсключение
            "Не все выбранные пользователи доступны "
            + "для загрузки из ERP. Обновите список.";

    КонецЕсли;

    Результат = ЗагрузкаПользователейERP.
        СинхронизироватьПользователей(Пакет);

    Возврат
        "Синхронизация завершена. Создано: "
        + Строка(Результат.Создано)
        + "; Обновлено: "
        + Строка(Результат.Обновлено);

КонецФункции

#КонецЕсли
