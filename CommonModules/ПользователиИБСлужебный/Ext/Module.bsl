// Проверяет существование пользователя ИБ по UUID.
//
// Параметры:
//  ИдентификаторИБ - УникальныйИдентификатор - UUID пользователя.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь существует.
Функция СуществуетПользовательИБПоUUID(ИдентификаторИБ) Экспорт

    ПользовательИБ =
        ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
            ИдентификаторИБ
        );

    Возврат ПользовательИБ <> Неопределено;

КонецФункции


// Ищет пользователя ИБ по имени или создает нового.
//
// Параметры:
//  ИмяПользователя - Строка - имя для входа.
//  ПолноеИмя - Строка - отображаемое имя.
//
// Возвращаемое значение:
//  Структура - результат операции, UUID и признак создания.
Функция ПолучитьИлиСоздатьПользователяИБ(
    ИмяПользователя,
    ПолноеИмя) Экспорт

    Результат = Новый Структура;

    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("UUID", Неопределено);
    Результат.Вставить("Создан", Ложь);
    Результат.Вставить("Сообщение", "");

    Попытка

        ПользовательИБ =
            ПользователиИнформационнойБазы.НайтиПоИмени(
                ИмяПользователя
            );

        Если ПользовательИБ = Неопределено Тогда

            ПользовательИБ =
                ПользователиИнформационнойБазы.СоздатьПользователя();

            ПользовательИБ.Имя = ИмяПользователя;
            ПользовательИБ.ПолноеИмя = ПолноеИмя;

            ПользовательИБ.АутентификацияСтандартная = Истина;
            ПользовательИБ.АутентификацияОС = Ложь;

            ПользовательИБ.Роли.Добавить(
                Метаданные.Роли.Менеджер
            );

            ПользовательИБ.Записать();

            Результат.Создан = Истина;

        КонецЕсли;

        Результат.UUID = ПользовательИБ.УникальныйИдентификатор;
        Результат.Успешно = Истина;

        Если Результат.Создан Тогда

            Результат.Сообщение = "Пользователь ИБ создан.";

        Иначе

            Результат.Сообщение =
                "Найден существующий пользователь ИБ.";

        КонецЕсли;

    Исключение

        Результат.Сообщение =
            "Ошибка работы с пользователем ИБ: "
            + ОписаниеОшибки();

    КонецПопытки;

    Возврат Результат;

КонецФункции