
Функция ПолучитьДанныеERPПоHTTP(Путь)

    ИмяПользователяERP =
        Константы.ИмяПользователяОбменаERP.Получить();

    ПарольERP =
        Константы.ПарольОбменаERP.Получить();

    Если ПустаяСтрока(ИмяПользователяERP)
        Или ПустаяСтрока(ПарольERP) Тогда

        ВызватьИсключение
            "Не заполнены настройки подключения к ERP.";

    КонецЕсли;

    // ERP и Моб.прил. опубликованы на одном компьютере.
    Соединение = Новый HTTPСоединение(
        "127.0.0.1",
        80,
        ,
        ,
        ,
        30);

    // Формируем Basic-авторизацию.
    СтрокаАвторизации =
        ИмяПользователяERP + ":" + ПарольERP;

    ДанныеАвторизации =
        ПолучитьДвоичныеДанныеИзСтроки(
            СтрокаАвторизации,
            КодировкаТекста.UTF8);

    Токен = Base64Строка(ДанныеАвторизации);

    Токен = СтрЗаменить(
        Токен, Символы.ВК, "");

    Токен = СтрЗаменить(
        Токен, Символы.ПС, "");

    Запрос = Новый HTTPЗапрос(Путь);

    Запрос.Заголовки.Вставить(
        "Authorization",
        "Basic " + Токен);

    Ответ = Соединение.Получить(Запрос);

    Если Ответ.КодСостояния <> 200 Тогда

        ВызватьИсключение
            "ERP вернула HTTP "
            + Строка(Ответ.КодСостояния);

    КонецЕсли;

    ТекстОтвета =
        Ответ.ПолучитьТелоКакСтроку();

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстОтвета);

    Данные = ПрочитатьJSON(ЧтениеJSON);

    ЧтениеJSON.Закрыть();

    Возврат Данные;

КонецФункции


Функция ВыполнитьСинхронизациюERP() Экспорт

    Если НЕ РольДоступна("ПолныеПрава") Тогда

        ВызватьИсключение
            "Недостаточно прав для синхронизации с ERP.";

    КонецЕсли;

    ПартнерыERP = ПолучитьДанныеERPПоHTTP(
        "/ERP/hs/mobileexchange/partners");

    КонтактыERP = ПолучитьДанныеERPПоHTTP(
        "/ERP/hs/mobileexchange/contactpersons");

    Результат = ЗаписатьДанныеНаСервере(
        ПартнерыERP,
        КонтактыERP);

    Возврат Результат;

КонецФункции


Функция ЗаписатьДанныеНаСервере(
    ПартнерыERP,
    КонтактыERP) Экспорт     
	
	Если НЕ РольДоступна("ПолныеПрава") Тогда
	    ВызватьИсключение
	        "Недостаточно прав для записи данных ERP.";
	КонецЕсли;

    КоличествоПартнеров = 0;
    КоличествоКонтактов = 0;

    Для Каждого ДанныеПартнера Из ПартнерыERP Цикл

        Если ПустаяСтрока(
            ДанныеПартнера.ИдентификаторERP) Тогда
            Продолжить;
        КонецЕсли;

        СсылкаПартнера =
            Справочники.Партнеры.НайтиПоРеквизиту(
                "ИдентификаторERP",
                ДанныеПартнера.ИдентификаторERP);

        Если СсылкаПартнера.Пустая() Тогда
            ОбъектПартнера =
                Справочники.Партнеры.СоздатьЭлемент();
        Иначе
            ОбъектПартнера =
                СсылкаПартнера.ПолучитьОбъект();
        КонецЕсли;

        ОбъектПартнера.Наименование =
            ДанныеПартнера.Наименование;

        ОбъектПартнера.НаименованиеПолное =
            ДанныеПартнера.НаименованиеПолное;

        ОбъектПартнера.Клиент =
            ДанныеПартнера.Клиент;

        ОбъектПартнера.Поставщик =
            ДанныеПартнера.Поставщик;

        ОбъектПартнера.Комментарий =
            ДанныеПартнера.Комментарий;

        ОбъектПартнера.ИдентификаторERP =
            ДанныеПартнера.ИдентификаторERP;

        ОбъектПартнера.Записать();

        КоличествоПартнеров =
            КоличествоПартнеров + 1;

    КонецЦикла;


    Для Каждого ДанныеКонтакта Из КонтактыERP Цикл

        Если ПустаяСтрока(
            ДанныеКонтакта.ИдентификаторERP) Тогда
            Продолжить;
        КонецЕсли;

        СсылкаПартнера =
            Справочники.Партнеры.НайтиПоРеквизиту(
                "ИдентификаторERP",
                ДанныеКонтакта.ИдентификаторПартнераERP);

        Если СсылкаПартнера.Пустая() Тогда
            Продолжить;
        КонецЕсли;

        СсылкаКонтакта =
            Справочники.КонтактныеЛица.НайтиПоРеквизиту(
                "ИдентификаторERP",
                ДанныеКонтакта.ИдентификаторERP);

        Если СсылкаКонтакта.Пустая() Тогда
            ОбъектКонтакта =
                Справочники.КонтактныеЛица.СоздатьЭлемент();
        Иначе
            ОбъектКонтакта =
                СсылкаКонтакта.ПолучитьОбъект();
        КонецЕсли;

        ОбъектКонтакта.Наименование =
            ДанныеКонтакта.Наименование;

        ОбъектКонтакта.Партнер =
            СсылкаПартнера;

        ОбъектКонтакта.Должность =
            ДанныеКонтакта.Должность;

        ОбъектКонтакта.Телефон =
            ДанныеКонтакта.Телефон;

        ОбъектКонтакта.Email =
            ДанныеКонтакта.Email;

        ОбъектКонтакта.ИдентификаторERP =
            ДанныеКонтакта.ИдентификаторERP;

        ОбъектКонтакта.Комментарий =
            ДанныеКонтакта.Комментарий;

        ОбъектКонтакта.ДополнительнаяИнформация =
            ДанныеКонтакта.ДополнительнаяИнформация;

        ОбъектКонтакта.Записать();

        КоличествоКонтактов =
            КоличествоКонтактов + 1;

    КонецЦикла;

    Возврат
        "Синхронизация завершена."
        + Символы.ПС
        + "Партнёров обработано: "
        + Строка(КоличествоПартнеров)
        + Символы.ПС
        + "Контактных лиц обработано: "
        + Строка(КоличествоКонтактов);

КонецФункции
