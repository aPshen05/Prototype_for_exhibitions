
Функция ПолучитьДанныеERPПоHTTP(Путь)

    ИмяПользователяERP =
        Константы.ИмяПользователяОбменаERP.Получить();

    ПарольERP =
        Константы.ПарольПользователяОбменаERP.Получить();

    Если ПустаяСтрока(ИмяПользователяERP)
        Или ПустаяСтрока(ПарольERP) Тогда

        ВызватьИсключение
            "Не заполнены настройки подключения к ERP.";

    КонецЕсли;

    Соединение = Новый HTTPСоединение(
        Константы.АдресСервераERP.Получить(),
        Константы.ПортСервераERP.Получить(),
        ,
        ,
        ,
        30);

    // Формируем Basic-авторизацию.
    СтрокаАвторизации =
        ИмяПользователяERP + ":" + ПарольERP;

    ДанныеАвторизации =
        ПолучитьДвоичныеДанныеИзСтроки(
            СтрокаАвторизации,
            КодировкаТекста.UTF8);

    Токен = Base64Строка(ДанныеАвторизации);

    Токен = СтрЗаменить(
        Токен, Символы.ВК, "");

    Токен = СтрЗаменить(
        Токен, Символы.ПС, "");

    Запрос = Новый HTTPЗапрос(Путь);

    Запрос.Заголовки.Вставить(
        "Authorization",
        "Basic " + Токен);

    Ответ = Соединение.Получить(Запрос);

    Если Ответ.КодСостояния <> 200 Тогда

        ВызватьИсключение
            "ERP вернула HTTP "
            + Строка(Ответ.КодСостояния);

    КонецЕсли;

    ТекстОтвета =
        Ответ.ПолучитьТелоКакСтроку();

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстОтвета);

    Данные = ПрочитатьJSON(ЧтениеJSON);

    ЧтениеJSON.Закрыть();

    Возврат Данные;

КонецФункции


Функция ВыполнитьСинхронизациюERP() Экспорт

    Если НЕ РольДоступна("ПолныеПрава") Тогда

        ВызватьИсключение
            "Недостаточно прав для синхронизации с ERP.";

    КонецЕсли;

    ПартнерыERP = ПолучитьДанныеERPПоHTTP(
        "/ERP/hs/mobileexchange/partners");

    КонтактыERP = ПолучитьДанныеERPПоHTTP(
        "/ERP/hs/mobileexchange/contactpersons");

    Результат = ЗаписатьДанныеНаСервере(
        ПартнерыERP,
        КонтактыERP);

    Возврат Результат;

КонецФункции


Функция ЗаписатьДанныеНаСервере(ПартнерыERP, КонтактыERP) Экспорт

    Если НЕ РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Недостаточно прав для записи данных ERP.";
    КонецЕсли;

    КоличествоПартнеров = 0;
    КоличествоКонтактов = 0;
    КоличествоЗаписейПартнеров = 0;
    СсылкиПартнеров = Новый Соответствие;

    Для Каждого ДанныеПартнера Из ПартнерыERP Цикл

        Если ПустаяСтрока(ДанныеПартнера.ИдентификаторERP) Тогда
            Продолжить;
        КонецЕсли;

        ИдентификаторERP = Новый УникальныйИдентификатор(ДанныеПартнера.ИдентификаторERP);
        СсылкаERP = Справочники.Партнеры.ПолучитьСсылку(ИдентификаторERP);
        ОбъектПартнера = СсылкаERP.ПолучитьОбъект();
        НовыйПартнер = Ложь;

        Если ОбъектПартнера = Неопределено Тогда

            СтараяСсылка = Справочники.Партнеры.НайтиПоРеквизиту(
				"ИдентификаторERP", Строка(ИдентификаторERP));
			
			Если НЕ СтараяСсылка.Пустая() Тогда
                ОбъектПартнера = СтараяСсылка.ПолучитьОбъект();
            Иначе
                ОбъектПартнера = Справочники.Партнеры.СоздатьЭлемент();
                ОбъектПартнера.УстановитьСсылкуНового(СсылкаERP);
                НовыйПартнер = Истина;
            КонецЕсли;

        КонецЕсли;

        
		Если ЗначениеЗаполнено(ОбъектПартнера.ИдентификаторERP)
		    И СокрЛП(ОбъектПартнера.ИдентификаторERP) <> Строка(ИдентификаторERP) Тогда

		    ВызватьИсключение "Конфликт UUID партнера: " + ДанныеПартнера.Наименование;

		КонецЕсли;


        ЕстьИзменения = НовыйПартнер;

        Если ОбъектПартнера.Наименование <> ДанныеПартнера.Наименование Тогда
            ОбъектПартнера.Наименование = ДанныеПартнера.Наименование;
            ЕстьИзменения = Истина;
        КонецЕсли;

        Если ОбъектПартнера.НаименованиеПолное <> ДанныеПартнера.НаименованиеПолное Тогда
            ОбъектПартнера.НаименованиеПолное = ДанныеПартнера.НаименованиеПолное;
            ЕстьИзменения = Истина;
        КонецЕсли;

        Если ОбъектПартнера.Клиент <> ДанныеПартнера.Клиент Тогда
            ОбъектПартнера.Клиент = ДанныеПартнера.Клиент;
            ЕстьИзменения = Истина;
        КонецЕсли;

        Если ОбъектПартнера.Поставщик <> ДанныеПартнера.Поставщик Тогда
            ОбъектПартнера.Поставщик = ДанныеПартнера.Поставщик;
            ЕстьИзменения = Истина;
        КонецЕсли;

        Если ОбъектПартнера.Комментарий <> ДанныеПартнера.Комментарий Тогда
            ОбъектПартнера.Комментарий = ДанныеПартнера.Комментарий;
            ЕстьИзменения = Истина;
        КонецЕсли;

        Если СокрЛП(ОбъектПартнера.ИдентификаторERP) <> Строка(ИдентификаторERP) Тогда
		    ОбъектПартнера.ИдентификаторERP = Строка(ИдентификаторERP);
		    ЕстьИзменения = Истина;
		КонецЕсли;

        Если ЕстьИзменения Тогда
            ОбъектПартнера.Записать();
            КоличествоЗаписейПартнеров = КоличествоЗаписейПартнеров + 1;
        КонецЕсли;

        СсылкиПартнеров.Вставить(Строка(ИдентификаторERP), ОбъектПартнера.Ссылка);
        КоличествоПартнеров = КоличествоПартнеров + 1;

    КонецЦикла;

    Для Каждого ДанныеПартнера Из ПартнерыERP Цикл

        Если ПустаяСтрока(ДанныеПартнера.ИдентификаторERP) Тогда
            Продолжить;
        КонецЕсли;

        ИдентификаторERP = Новый УникальныйИдентификатор(ДанныеПартнера.ИдентификаторERP);
        СсылкаПартнера = СсылкиПартнеров.Получить(Строка(ИдентификаторERP));

        Если СсылкаПартнера = Неопределено Тогда
            ВызватьИсключение "Не найдена ссылка партнера: " + ДанныеПартнера.Наименование;
        КонецЕсли;

        СсылкаРодителя = Справочники.Партнеры.ПустаяСсылка();

        Если НЕ ПустаяСтрока(ДанныеПартнера.ИдентификаторРодителяERP) Тогда

            ИдентификаторРодителя = Новый УникальныйИдентификатор(
				ДанныеПартнера.ИдентификаторРодителяERP);
            СсылкаРодителя = СсылкиПартнеров.Получить(Строка(ИдентификаторРодителя));

            Если СсылкаРодителя = Неопределено Тогда
                ВызватьИсключение "Родитель партнера не загружен: " 
					+ ДанныеПартнера.Наименование;
            КонецЕсли;

            Если СсылкаРодителя = СсылкаПартнера Тогда
                ВызватьИсключение "Партнер не может быть собственным родителем.";
            КонецЕсли;

        КонецЕсли;

        ОбъектПартнера = СсылкаПартнера.ПолучитьОбъект();

        Если ОбъектПартнера.Родитель <> СсылкаРодителя Тогда
            ОбъектПартнера.Родитель = СсылкаРодителя;
            ОбъектПартнера.Записать();
            КоличествоЗаписейПартнеров = КоличествоЗаписейПартнеров + 1;
        КонецЕсли;

    КонецЦикла;

    Для Каждого ДанныеКонтакта Из КонтактыERP Цикл

        Если ПустаяСтрока(ДанныеКонтакта.ИдентификаторERP)
            Или ПустаяСтрока(ДанныеКонтакта.ИдентификаторПартнераERP) Тогда
            Продолжить;
        КонецЕсли;

        ИдентификаторПартнера = Новый УникальныйИдентификатор(
			ДанныеКонтакта.ИдентификаторПартнераERP);
        СсылкаПартнера = СсылкиПартнеров.Получить(Строка(ИдентификаторПартнера));

        Если СсылкаПартнера = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        СсылкаКонтакта = Справочники.КонтактныеЛица.НайтиПоРеквизиту(
            "ИдентификаторERP", ДанныеКонтакта.ИдентификаторERP);

        Если СсылкаКонтакта.Пустая() Тогда
            ОбъектКонтакта = Справочники.КонтактныеЛица.СоздатьЭлемент();
        Иначе
            ОбъектКонтакта = СсылкаКонтакта.ПолучитьОбъект();
        КонецЕсли;

        ОбъектКонтакта.Наименование = ДанныеКонтакта.Наименование;
        ОбъектКонтакта.Партнер = СсылкаПартнера;
        ОбъектКонтакта.Должность = ДанныеКонтакта.Должность;
        ОбъектКонтакта.Телефон = ДанныеКонтакта.Телефон;
        ОбъектКонтакта.Email = ДанныеКонтакта.Email;
        ОбъектКонтакта.ИдентификаторERP = ДанныеКонтакта.ИдентификаторERP;
        ОбъектКонтакта.Комментарий = ДанныеКонтакта.Комментарий;
        ОбъектКонтакта.ДополнительнаяИнформация = ДанныеКонтакта.ДополнительнаяИнформация;

        ОбъектКонтакта.Записать();
        КоличествоКонтактов = КоличествоКонтактов + 1;

    КонецЦикла;

    Возврат "Синхронизация завершена."
        + Символы.ПС + "Партнеров обработано: " + Строка(КоличествоПартнеров)
        + Символы.ПС + "Записей партнеров выполнено: " + Строка(КоличествоЗаписейПартнеров)
        + Символы.ПС + "Контактных лиц обработано: " + Строка(КоличествоКонтактов);

КонецФункции


Функция ЗагрузитьМенеджеровИзERP() Экспорт

    Если НЕ РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Недостаточно прав для загрузки менеджеров.";
    КонецЕсли;

    ПользователиERP = ПолучитьДанныеERPПоHTTP(
        "/ERP/hs/mobileexchange/users");

    Результат = ЗагрузкаПользователейERP.СинхронизироватьПользователей(ПользователиERP);

    Возврат
        "Менеджеры ERP загружены. Создано: "
        + Строка(Результат.Создано)
        + "; Обновлено: "
        + Строка(Результат.Обновлено);

КонецФункции
