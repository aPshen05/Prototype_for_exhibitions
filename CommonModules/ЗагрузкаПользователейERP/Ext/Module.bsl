
Функция ЗагрузитьПользователей(ДанныеERP) Экспорт

    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Недостаточно прав для загрузки пользователей.";
    КонецЕсли;

    РольМенеджера = Метаданные.Роли.Найти("Менеджер");

    Если РольМенеджера = Неопределено Тогда
        ВызватьИсключение
            "В конфигурации Prot не найдена роль Менеджер.";
    КонецЕсли;

    Для Каждого Данные Из ДанныеERP Цикл

        Если Не Данные.Свойство("Имя")
            Или Не Данные.Свойство("ИдентификаторERP")
            Или Не Данные.Свойство("СохраняемоеЗначениеПароля") Тогда

            ВызватьИсключение
                "Неполные данные пользователя ERP.";

        КонецЕсли;

        Если Не ЗначениеЗаполнено(Данные.Имя)
            Или Не ЗначениеЗаполнено(Данные.ИдентификаторERP)
            Или Не ЗначениеЗаполнено(
                Данные.СохраняемоеЗначениеПароля) Тогда

            ВызватьИсключение
                "Отсутствует имя, идентификатор или пароль.";

        КонецЕсли;

        Если Данные.Имя = "Администратор" Тогда
            ВызватьИсключение
                "Перенос администратора запрещён.";
        КонецЕсли;


        Существующий =
            ПользователиИнформационнойБазы.НайтиПоИмени(
                Данные.Имя);

        Если Существующий <> Неопределено Тогда
            ВызватьИсключение
                "Пользователь уже существует в Prot: "
                + Данные.Имя;
        КонецЕсли;

    КонецЦикла;

    Результат = Новый Структура(
        "Создано,Пропущено", 0, 0);

    Для Каждого Данные Из ДанныеERP Цикл

        ПользовательИБ =
            ПользователиИнформационнойБазы.СоздатьПользователя();

        ПользовательИБ.Имя = Данные.Имя;

        Если Данные.Свойство("ПолноеИмя") Тогда
            ПользовательИБ.ПолноеИмя = Данные.ПолноеИмя;
        Иначе
            ПользовательИБ.ПолноеИмя = Данные.Имя;
        КонецЕсли;

        ПользовательИБ.АутентификацияСтандартная = Истина;

        ПользовательИБ.СохраняемоеЗначениеПароля =
            Данные.СохраняемоеЗначениеПароля;

        ПользовательИБ.Роли.Добавить(РольМенеджера);

        ПользовательИБ.Записать();

        СсылкаПользователя =
            Справочники.Пользователи.НайтиПоРеквизиту(
                "ИдентификаторERP",
                Новый УникальныйИдентификатор(
                    Данные.ИдентификаторERP));

        Если СсылкаПользователя.Пустая() Тогда

            ПользовательСправочника =
                Справочники.Пользователи.СоздатьЭлемент();

        Иначе

            ПользовательСправочника =
                СсылкаПользователя.ПолучитьОбъект();

        КонецЕсли;

        ПользовательСправочника.Наименование =
            ПользовательИБ.ПолноеИмя;

        ПользовательСправочника.ИдентификаторERP =
            Новый УникальныйИдентификатор(
                Данные.ИдентификаторERP);

        ПользовательСправочника.ИдентификаторПользователяИБ =
            ПользовательИБ.УникальныйИдентификатор;

        ПользовательСправочника.Недействителен = Ложь;

        ПользовательСправочника.Записать();

        Результат.Создано = Результат.Создано + 1;

    КонецЦикла;

    Возврат Результат;

КонецФункции  


Функция СинхронизироватьПользователей(ДанныеERP) Экспорт

    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Синхронизация доступна только администратору.";
    КонецЕсли;

    РольМенеджера = Метаданные.Роли.Найти("Менеджер");

    Если РольМенеджера = Неопределено Тогда
        ВызватьИсключение
            "В Prot отсутствует роль Менеджер.";
    КонецЕсли;

    Результат = Новый Структура(
        "Создано,Обновлено", 0, 0);

    Для Каждого Данные Из ДанныеERP Цикл

        Если Данные.Имя = "Администратор" Тогда
            ВызватьИсключение
                "Перенос администратора запрещён.";
        КонецЕсли;

        Если Не ЗначениеЗаполнено(Данные.Имя)
            Или Не ЗначениеЗаполнено(Данные.ИдентификаторERP)
            Или Не ЗначениеЗаполнено(
                Данные.СохраняемоеЗначениеПароля) Тогда

            ВызватьИсключение
                "Неполные данные пользователя ERP.";

        КонецЕсли;

        ИдентификаторERP =
            Новый УникальныйИдентификатор(
                Данные.ИдентификаторERP);

        Ссылка = Справочники.Пользователи.НайтиПоРеквизиту(
            "ИдентификаторERP",
            ИдентификаторERP);

        Если Ссылка.Пустая() Тогда

            // Новая учётная запись.
            // Существующая функция проверяет совпадение имени.
            Пакет = Новый Массив;
            Пакет.Добавить(Данные);

            ЗагрузитьПользователей(Пакет);

            Результат.Создано = Результат.Создано + 1;

        Иначе

            // Пользователь уже был импортирован из ERP.
            ПользовательСправочника = Ссылка.ПолучитьОбъект();

            ИдентификаторИБ =
                ПользовательСправочника.
                    ИдентификаторПользователяИБ;

            Если Не ЗначениеЗаполнено(ИдентификаторИБ) Тогда
                ВызватьИсключение
                    "Не заполнена связь с пользователем ИБ: "
                    + Данные.Имя;
            КонецЕсли;

            ПользовательИБ =
                ПользователиИнформационнойБазы.
                    НайтиПоУникальномуИдентификатору(
                        ИдентификаторИБ);

            Если ПользовательИБ = Неопределено Тогда
                ВызватьИсключение
                    "Пользователь ИБ не найден: "
                    + Данные.Имя;
            КонецЕсли;

            // Не перепривязываем существующую запись
            // к другому пользователю по совпадению имени.
            Если ПользовательИБ.Имя <> Данные.Имя Тогда
                ВызватьИсключение
                    "Не совпадает имя связанного пользователя: "
                    + Данные.Имя;
            КонецЕсли;

            Для Каждого РольИБ Из ПользовательИБ.Роли Цикл

                Если РольИБ.Имя = "ПолныеПрава" Тогда
                    ВызватьИсключение
                        "Нельзя обновлять пользователя "
                        + "с полными правами: " + Данные.Имя;
                КонецЕсли;

            КонецЦикла;

            ПользовательИБ.ПолноеИмя = Данные.ПолноеИмя;
            ПользовательИБ.АутентификацияСтандартная = Истина;

            // ERP является источником пароля.
            Если ПользовательИБ.СохраняемоеЗначениеПароля
                <> Данные.СохраняемоеЗначениеПароля Тогда

                ПользовательИБ.СохраняемоеЗначениеПароля =
                    Данные.СохраняемоеЗначениеПароля;

            КонецЕсли;

            // Для импортированного менеджера оставляем только роль Менеджер в Моб.прил.
            ПользовательИБ.Роли.Очистить();
            ПользовательИБ.Роли.Добавить(РольМенеджера);

            ПользовательИБ.Записать();

            ПользовательСправочника.Наименование =
                Данные.ПолноеИмя;

            ПользовательСправочника.Недействителен = Ложь;

            ПользовательСправочника.Записать();

            Результат.Обновлено =
                Результат.Обновлено + 1;

        КонецЕсли;

    КонецЦикла;

    Возврат Результат;

КонецФункции
