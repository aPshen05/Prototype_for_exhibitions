#Область ПрограммныйИнтерфейс


Функция ПолучитьАктуальнуюВыставку() Экспорт

    ТекущаяВыставка = Константы.ТекущаяВыставка.Получить();

    Если НЕ ЗначениеЗаполнено(ТекущаяВыставка) Тогда
        Возврат Справочники.Выставки.ПустаяСсылка();
    КонецЕсли;

    Возврат ТекущаяВыставка;

КонецФункции

Процедура УстановитьТекущуюВыставку(Выставка) Экспорт

    Если НЕ РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Текущую выставку может изменять только администратор.";
    КонецЕсли;

    Константы.ТекущаяВыставка.Установить(Выставка);

КонецПроцедуры

Процедура ВыгрузитьДанныеВТекст(ДанныеДляВыгрузки, ПутьКФайлу) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписатьJSON(ЗаписьJSON, ДанныеДляВыгрузки);
	ЗаписьJSON.Закрыть();
КонецПроцедуры

Функция ЗагрузитьДанныеИзТекста(ПутьКФайлу) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ПутьКФайлу);
	ВосстановленныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	
	Возврат ВосстановленныеДанные;
КонецФункции

#КонецОбласти