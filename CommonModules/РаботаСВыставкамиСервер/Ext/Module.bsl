#Область ПрограммныйИнтерфейс

// Проверяет, актуальна ли выбранная выставка (сброс в 04:00 утра следующих суток по макету 05.1).
//
// Возвращаемое значение:
//  СправочникСсылка.Выставки - Текущая актуальная выставка или ПустаяСсылка.
//
Функция ПолучитьАктуальнуюВыставку() Экспорт
	
	ТекущаяВыставка = Константы.ТекущаяВыставка.Получить();
	ДатаВыбора = Константы.ДатаВыбораВыставки.Получить();
	
	Если НЕ ЗначениеЗаполнено(ТекущаяВыставка) Или НЕ ЗначениеЗаполнено(ДатаВыбора) Тогда
		Возврат Справочники.Выставки.ПустаяСсылка();
	КонецЕсли;
	
	// Вычисляем границу 04:00 утра следующих суток после выбора
	НачалоСледующегоДня = НачалоДня(ДатаВыбора) + 86400;
	ГраницаСброса = НачалоСледующегоДня + (4 * 3600);
	
	Если ТекущаяДатаСеанса() >= ГраницаСброса Тогда
		Константы.ТекущаяВыставка.Установить(Справочники.Выставки.ПустаяСсылка());
		Возврат Справочники.Выставки.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ТекущаяВыставка;
	
КонецФункции

// Устанавливает выбранную выставку на текущий рабочий день.
//
// Параметры:
//  Выставка - СправочникСсылка.Выставки - Выбранная менеджером выставка.
//
Процедура УстановитьТекущуюВыставку(Выставка) Экспорт
	
	Константы.ТекущаяВыставка.Установить(Выставка);
	Константы.ДатаВыбораВыставки.Установить(ТекущаяДатаСеанса());
	
КонецПроцедуры
#КонецОбласти