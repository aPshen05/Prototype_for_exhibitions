#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Заголовок = "Выставки";
	ОтрисоватьКарточкиВыставокНаСервере();    
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтрисоватьКарточкиВыставокНаСервере();
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции


&НаСервере
Функция ПроверитьИУстановитьВыставкуНаСервере(ВыбраннаяВыставка)

	Если РольДоступна("ПолныеПрава") Тогда

        РаботаСВыставкамиСервер.УстановитьТекущуюВыставку(ВыбраннаяВыставка);
		Возврат Истина;

    КонецЕсли;

    ТекущаяВыставка = РаботаСВыставкамиСервер.ПолучитьАктуальнуюВыставку();

    Если ТекущаяВыставка = ВыбраннаяВыставка Тогда
        Возврат Истина;
    КонецЕсли;

    Возврат Ложь;

КонецФункции

&НаСервере
Процедура ОтрисоватьКарточкиВыставокНаСервере()
	
	СписокВыставок.Очистить();

	Элементы.ГруппаКарточкиВыставок.Видимость = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Выставки.Ссылка КАК Ссылка,
		|	Выставки.Наименование КАК Наименование,
		|	Выставки.Город КАК Город,
		|	Выставки.ДатаНачала КАК ДатаНачала,
		|	Выставки.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Справочник.Выставки КАК Выставки
		|ГДЕ
		|	НЕ Выставки.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Выставки.ДатаНачала УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = СписокВыставок.Добавить();
		СтрокаТаблицы.Ссылка = Выборка.Ссылка;
		
		СтрокаДат = "";
		Если ЗначениеЗаполнено(Выборка.ДатаНачала) Тогда
			Если ЗначениеЗаполнено(Выборка.ДатаОкончания) И НачалоДня(Выборка.ДатаНачала) <> НачалоДня(Выборка.ДатаОкончания) Тогда
				Если Месяц(Выборка.ДатаНачала) = Месяц(Выборка.ДатаОкончания) Тогда
					СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ=дд") + " - " + Формат(Выборка.ДатаОкончания, "ДФ='дд ММММ'");
				Иначе
					СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ='дд ММММ'") + " - " + Формат(Выборка.ДатаОкончания, "ДФ='дд ММММ'");
				КонецЕсли;
			Иначе
				СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ='дд ММММ'");
			КонецЕсли;
		КонецЕсли;
		
		СтрокаДеталей = Выборка.Город;
		Если ЗначениеЗаполнено(СтрокаДат) Тогда
			Если ЗначениеЗаполнено(СтрокаДеталей) Тогда
				СтрокаДеталей = СтрокаДеталей + " • " + СтрокаДат;
			Иначе
				СтрокаДеталей = СтрокаДат;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТаблицы.Описание = Выборка.Наименование + Символы.ПС + СтрокаДеталей;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура СписокВыставокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ТекущиеДанные = Элементы.СписокВыставок.ТекущиеДанные;

    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ВыбраннаяВыставка = ТекущиеДанные.Ссылка;

    Попытка
        Разрешено = ПроверитьИУстановитьВыставкуНаСервере(ВыбраннаяВыставка);

    Исключение
        Сообщить("Ошибка выбора выставки: " + ОписаниеОшибки());
        Возврат;

	КонецПопытки;

    Если НЕ Разрешено Тогда
        Сообщить("Эта выставка не является текущей. " + "Обратитесь к администратору.");
        Возврат;
    КонецЕсли;

    ПараметрыФормы = Новый Структура("Выставка", ВыбраннаяВыставка);

    ОткрытьФорму("ОбщаяФорма.ЭкранВыставки", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьСERP(Команда)

    ОбменСERP.СинхронизироватьСERP();

КонецПроцедуры

#КонецОбласти