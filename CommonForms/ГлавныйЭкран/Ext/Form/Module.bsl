#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Заголовок = "Выставки";
	ОтрисоватьКарточкиВыставокНаСервере();    
	
	// Административные кнопки видны только для ПолныеПрава.
    ЭтоАдминистратор = РольДоступна("ПолныеПрава");

    КнопкаСинхронизации =
        Элементы.Найти("СинхронизироватьСERP");

    Если КнопкаСинхронизации <> Неопределено Тогда
        КнопкаСинхронизации.Видимость = ЭтоАдминистратор;
    КонецЕсли;

    КнопкаПользователей =
        Элементы.Найти("ЗагрузитьТестМенеджера");

    Если КнопкаПользователей <> Неопределено Тогда
        КнопкаПользователей.Видимость = ЭтоАдминистратор;
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтрисоватьКарточкиВыставокНаСервере();
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВыставкуНаСервере(ВыбраннаяВыставка)
	
	РаботаСВыставкамиСервер.УстановитьТекущуюВыставку(ВыбраннаяВыставка);
	
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьКарточкиВыставокНаСервере()
	
	СписокВыставок.Очистить();

	Элементы.ГруппаКарточкиВыставок.Видимость = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Выставки.Ссылка КАК Ссылка,
		|	Выставки.Наименование КАК Наименование,
		|	Выставки.Город КАК Город,
		|	Выставки.ДатаНачала КАК ДатаНачала,
		|	Выставки.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Справочник.Выставки КАК Выставки
		|ГДЕ
		|	НЕ Выставки.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Выставки.ДатаНачала УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = СписокВыставок.Добавить();
		СтрокаТаблицы.Ссылка = Выборка.Ссылка;
		
		СтрокаДат = "";
		Если ЗначениеЗаполнено(Выборка.ДатаНачала) Тогда
			Если ЗначениеЗаполнено(Выборка.ДатаОкончания) И НачалоДня(Выборка.ДатаНачала) <> НачалоДня(Выборка.ДатаОкончания) Тогда
				Если Месяц(Выборка.ДатаНачала) = Месяц(Выборка.ДатаОкончания) Тогда
					СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ=дд") + " - " + Формат(Выборка.ДатаОкончания, "ДФ='дд ММММ'");
				Иначе
					СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ='дд ММММ'") + " - " + Формат(Выборка.ДатаОкончания, "ДФ='дд ММММ'");
				КонецЕсли;
			Иначе
				СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ='дд ММММ'");
			КонецЕсли;
		КонецЕсли;
		
		СтрокаДеталей = Выборка.Город;
		Если ЗначениеЗаполнено(СтрокаДат) Тогда
			Если ЗначениеЗаполнено(СтрокаДеталей) Тогда
				СтрокаДеталей = СтрокаДеталей + " • " + СтрокаДат;
			Иначе
				СтрокаДеталей = СтрокаДат;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТаблицы.Описание = Выборка.Наименование + Символы.ПС + СтрокаДеталей;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыставокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 	
	ТекущиеДанные = Элементы.СписокВыставок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВыставкуНаСервере(ТекущиеДанные.Ссылка);
	
	ПараметрыФормы = Новый Структура("Выставка", ТекущиеДанные.Ссылка);
	ОткрытьФорму("ОбщаяФорма.ЭкранВыставки", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьСERP(Команда)

    ОбменСERP.СинхронизироватьСERP();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьТестМенеджера(Команда)

    ОткрытьФорму("ОбщаяФорма.ВыборМенеджеровERP");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьТестМенеджераНаСервере()

    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение
            "Недостаточно прав для загрузки пользователей.";
    КонецЕсли;

    #Если Сервер И Не МобильноеПриложениеСервер И Не МобильныйАвтономныйСервер Тогда

        Возврат ЗагрузкаПользователейERPОсновнойСервер.
            ЗагрузитьТестМенеджераИзERP();

    #Иначе

        ВызватьИсключение
            "Загрузка пользователей доступна только "
            + "на основном сервере Prot.";

    #КонецЕсли

КонецФункции

#КонецОбласти