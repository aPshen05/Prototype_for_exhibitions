#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Заголовок = "";
	ОтрисоватьКарточкиВыставокНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтрисоватьКарточкиВыставокНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НажатиеНаКарточкуВыставки(Команда)
	
	ВыбраннаяСсылка = Неопределено;
	
	// Способ 1: определяем нажатую кнопку через ЭтаФорма.ТекущийЭлемент
	Если ЭтаФорма.ТекущийЭлемент <> Неопределено Тогда
		ИмяКнопки = ЭтаФорма.ТекущийЭлемент.Имя; // например, "КнопкаВыставка_0"
		ИндексСтрока = СтрЗаменить(ИмяКнопки, "КнопкаВыставка_", "");
		
		Для Индекс = 0 По СписокВыставок.Количество() - 1 Цикл
			Если Формат(Индекс, "ЧГ=0") = ИндексСтрока Тогда
				ВыбраннаяСсылка = СписокВыставок[Индекс].Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Способ 2 (резервный): если ТекущийЭлемент не определился, ищем по тексту карточки
	Если ВыбраннаяСсылка = Неопределено И Команда <> Неопределено Тогда
		Попытка
			Для Каждого СтрокаВыставки Из СписокВыставок Цикл
				Если СтрокаВыставки.Описание = Команда.Заголовок Тогда
					ВыбраннаяСсылка = СтрокаВыставки.Ссылка;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Если в списке вообще одна или первая выставка — открываем её
	Если ВыбраннаяСсылка = Неопределено И СписокВыставок.Количество() > 0 Тогда
		ВыбраннаяСсылка = СписокВыставок[0].Ссылка;
	КонецЕсли;
	
	Если ВыбраннаяСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВыставкуНаСервере(ВыбраннаяСсылка);
	
	ПараметрыФормы = Новый Структура("Выставка", ВыбраннаяСсылка);
	ОткрытьФорму("ОбщаяФорма.ЭкранВыставки", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВыставкуНаСервере(ВыбраннаяВыставка)
	
	РаботаСВыставкамиСервер.УстановитьТекущуюВыставку(ВыбраннаяВыставка);
	
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьКарточкиВыставокНаСервере()
	
	СписокВыставок.Очистить();
	
	// Очищаем старые кнопки перед перерисовкой
	Пока Элементы.ГруппаКарточкиВыставок.ПодчиненныеЭлементы.Количество() > 0 Цикл
		Элементы.Удалить(Элементы.ГруппаКарточкиВыставок.ПодчиненныеЭлементы[0]);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Выставки.Ссылка КАК Ссылка,
		|	Выставки.Наименование КАК Наименование,
		|	Выставки.Город КАК Город,
		|	Выставки.ДатаНачала КАК ДатаНачала,
		|	Выставки.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Справочник.Выставки КАК Выставки
		|ГДЕ
		|	НЕ Выставки.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Выставки.ДатаНачала УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Индекс = 0;
	
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = СписокВыставок.Добавить();
		СтрокаТаблицы.Ссылка = Выборка.Ссылка;
		
		СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ='дд'") + "–" + Формат(Выборка.ДатаНачала, "ДФ='дд ММММ'");
		Если ЗначениеЗаполнено(Выборка.ДатаОкончания) Тогда
			СтрокаДат = Формат(Выборка.ДатаНачала, "ДФ='дд'") + "–" + Формат(Выборка.ДатаОкончания, "ДФ='дд ММММ'");
		КонецЕсли;
		
		ТекстКарточки = Выборка.Наименование + Символы.ПС + Выборка.Город + " · " + СтрокаДат;
		СтрокаТаблицы.Описание = ТекстКарточки;
		
		// Создаем или находим команду для этой карточки
		ИмяКоманды = "КомандаВыставка_" + Формат(Индекс, "ЧГ=0");
		КомандаКарточки = Команды.Найти(ИмяКоманды);
		Если КомандаКарточки = Неопределено Тогда
			КомандаКарточки = Команды.Добавить(ИмяКоманды);
			КомандаКарточки.Действие = "НажатиеНаКарточкуВыставки";
		КонецЕсли;
		КомандаКарточки.Заголовок = ТекстКарточки;
		
		// Создаем кнопку-карточку с темной рамкой по контуру
		ИмяКнопки = "КнопкаВыставка_" + Формат(Индекс, "ЧГ=0");
		КнопкаКарточки = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы.ГруппаКарточкиВыставок);
		КнопкаКарточки.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КнопкаКарточки.ИмяКоманды = ИмяКоманды;
		КнопкаКарточки.РастягиватьПоГоризонтали = Истина;
		КнопкаКарточки.Высота = 3;
		
		// Задаем темную рамку по кругу и оформление карточки
		КнопкаКарточки.ЦветРамки = Новый Цвет(51, 61, 56); // Темная рамка вокруг карточки
		КнопкаКарточки.Шрифт = Новый Шрифт(, 14, Истина);
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти