
&НаСервере
Процедура ПриСозданииНаСервере(
    Отказ, СтандартнаяОбработка)

    СписокМенеджеров.Очистить();

    Пользователи =
        ЗагрузкаПользователейERPОсновнойСервер.
            ПолучитьСписокДляВыбора();

    Для Каждого Данные Из Пользователи Цикл

        НоваяСтрока = СписокМенеджеров.Добавить();

        НоваяСтрока.Выбран = Ложь;
        НоваяСтрока.Имя = Данные.Имя;

        НоваяСтрока.ПолноеИмя =
            Данные.ПолноеИмя;

        НоваяСтрока.ИдентификаторERP =
            Данные.ИдентификаторERP;

        НоваяСтрока.Доступен =
            Данные.Доступен;

        НоваяСтрока.Состояние =
            Данные.Состояние;

    КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура ВыбратьВсех(Команда)

    Для Каждого СтрокаМенеджера Из СписокМенеджеров Цикл

        Если СтрокаМенеджера.Доступен Тогда
            СтрокаМенеджера.Выбран = Истина;
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура ЗагрузитьВыбранных(Команда)

    Выбранные = Новый Массив;

    Для Каждого СтрокаМенеджера Из СписокМенеджеров Цикл

        Если Не СтрокаМенеджера.Выбран Тогда
            Продолжить;
        КонецЕсли;

        Если Не СтрокаМенеджера.Доступен Тогда

            Сообщить(
                "Нельзя загрузить пользователя: "
                + СтрокаМенеджера.Имя
                + ". Причина: "
                + СтрокаМенеджера.Состояние);

            Возврат;

        КонецЕсли;

        Выбранные.Добавить(
            СтрокаМенеджера.ИдентификаторERP);

    КонецЦикла;

    Если Выбранные.Количество() = 0 Тогда
        Сообщить("Выбери хотя бы одного менеджера.");
        Возврат;
    КонецЕсли;

    Попытка

        Результат = ЗагрузитьВыбранныхНаСервере(
            Выбранные);

        Сообщить(Результат);

        Закрыть();

    Исключение

        Сообщить(
            "Ошибка загрузки менеджеров: "
            + ОписаниеОшибки());

    КонецПопытки;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ЗагрузитьВыбранныхНаСервере(
    Выбранные)

    Возврат
        ЗагрузкаПользователейERPОсновнойСервер.
            ЗагрузитьВыбранныхИзERP(Выбранные);

КонецФункции
