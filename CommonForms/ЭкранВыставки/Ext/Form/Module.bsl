#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Выставка") И ЗначениеЗаполнено(Параметры.Выставка) Тогда
		ТекущаяВыставка = Параметры.Выставка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяВыставка) Тогда
		Элементы.ШапкаНазваниеВыставки.Заголовок = Строка("Выставка: " + ТекущаяВыставка);
	Иначе
		Элементы.ШапкаНазваниеВыставки.Заголовок = "Выставка не выбрана";
	КонецЕсли;
	
	НастроитьУсловноеОформлениеТемпературы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗагрузитьСписокКонтактовВыставки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтактСохранен" Тогда
		ЗагрузитьСписокКонтактовВыставки();
		ПоказатьОповещениеПользователя("Контакт №" + СокрЛП(Параметр) + " сохранён");
	ИначеЕсли ИмяСобытия = "ОбменЗавершен" Тогда
		ЗагрузитьСписокКонтактовВыставки();
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КонтактыСегодняВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = Элементы.КонтактыСегодня.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", ДанныеСтроки.Ссылка);
	ОткрытьФорму("Справочник.Контакты.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура НовыйКонтакт(Команда)
	
	ЗначенияЗаполнения = Новый Структура("Выставка", ТекущаяВыставка); 
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Справочник.Контакты.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)
	
	ЗагрузитьСписокКонтактовВыставки();
	ПоказатьОповещениеПользователя("Проверка синхронизации выполнена");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьСписокКонтактовВыставки()
	
	КонтактыСегодня.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контакты.Ссылка КАК Ссылка,
		|	Контакты.ДатаФиксации КАК ДатаФиксации,
		|	Контакты.Наименование КАК Наименование,
		|	Контакты.Температура КАК Температура,
		|	Контакты.Отправлен КАК Отправлен
		|ИЗ
		|	Справочник.Контакты КАК Контакты
		|ГДЕ
		|	Контакты.Выставка = &Выставка
		|	И НЕ Контакты.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контакты.ДатаФиксации УБЫВ";
	
	Запрос.УстановитьПараметр("Выставка", ТекущаяВыставка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ВсегоКонтактов = 0;
	
	Пока Выборка.Следующий() Цикл
		ВсегоКонтактов = ВсегоКонтактов + 1;
		StringКонтакта = КонтактыСегодня.Добавить();
		StringКонтакта.Ссылка = Выборка.Ссылка;
		StringКонтакта.Отправлен = Выборка.Отправлен;
		
		ТекстВремя = Формат(Выборка.ДатаФиксации, "ДФ=ЧЧ:мм");
		
		СимволТочки = "○"; 
		Если Выборка.Температура = Перечисления.ТемператураЛида.Горячий Тогда
			СимволТочки = "●"; 
		ИначеЕсли Выборка.Температура = Перечисления.ТемператураЛида.Теплый Тогда
			СимволТочки = "●"; 
		ИначеЕсли Выборка.Температура = Перечисления.ТемператураЛида.Холодный Тогда
			СимволТочки = "●"; 
		КонецЕсли;
		
		ИмяКомпания = ?(ЗначениеЗаполнено(Выборка.Наименование), Выборка.Наименование, "Без названия");
		
		ТекстСтатус = ?(Выборка.Отправлен, "✓", "в очереди");
		
		StringКонтакта.ПрезентацияСтрокой = ТекстВремя + "    " + СимволТочки + "    " + ИмяКомпания + "    (" + ТекстСтатус + ")";
		
	КонецЦикла;
	

	ЗаголовокСпискаСегодня = "контактов: " + Строка(ВсегоКонтактов);
	
	ЗапросОчереди = Новый Запрос;
	ЗапросОчереди.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Контакты.Ссылка) КАК КоличествоНеотправленных
		|ИЗ
		|	Справочник.Контакты КАК Контакты
		|ГДЕ
		|	Контакты.Выставка = &Выставка
		|	И Контакты.Отправлен = ЛОЖЬ
		|	И НЕ Контакты.ПометкаУдаления";
	ЗапросОчереди.УстановитьПараметр("Выставка", ТекущаяВыставка);
	
	ВыборкаОчереди = ЗапросОчереди.Выполнить().Выбрать();
	КоличествоНеотправленных = 0;
	Если ВыборкаОчереди.Следующий() Тогда
		КоличествоНеотправленных = ВыборкаОчереди.КоличествоНеотправленных;
	КонецЕсли;
	
	Если КоличествоНеотправленных = 0 Тогда
		СтатусОчереди = "всё отправлено";
		Элементы.СтатусОчереди.ЦветТекста = Новый Цвет(31, 106, 90);
	Иначе
		СтатусОчереди = Строка(КоличествоНеотправленных) + " в очереди";
		Элементы.СтатусОчереди.ЦветТекста = Новый Цвет(154, 106, 18);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформлениеТемпературы()
	
	УсловноеОформление.Элементы.Очистить();
	
	ДобавитьЦветТочкиТемпературы(1, Новый Цвет(168, 69, 43));
	ДобавитьЦветТочкиТемпературы(2, Новый Цвет(154, 106, 18));
	ДобавитьЦветТочкиТемпературы(3, Новый Цвет(47, 98, 135));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЦветТочкиТемпературы(КодТемпературы, ЦветТочки)
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("КонтактыСегодняИндикаторТемпературы");
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КонтактыСегодня.КодТемпературы");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = КодТемпературы;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТочки);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущаяВыставкаПриИзменении(Элемент)
	ЗагрузитьСписокКонтактовВыставки();
КонецПроцедуры
#КонецОбласти